{
  "name": "xelra",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "workspaces": [
    "packages/lab"
  ],
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "tsc --noEmit && vite build && node infrastructure/scripts/app-build-check.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit && npm run typecheck -w packages/lab",
    "test:browser": "playwright test",
    "test": "node --test tests/*.test.mjs && python -m unittest discover -s tests -p \"test_*.py\" && npm test -w packages/lab",
    "infra:headers": "node infrastructure/scripts/static-headers.mjs out",
    "infra:check": "python infrastructure/scripts/check.py"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.10",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "parse5": "8.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
