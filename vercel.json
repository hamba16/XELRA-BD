{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --ignore-scripts",
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "rewrites": [
    { "source": "/auth/callback", "destination": "/index.html" },
    { "source": "/auth/callback/", "destination": "/index.html" },
    { "source": "/inbox", "destination": "/index.html" },
    { "source": "/projects", "destination": "/index.html" },
    { "source": "/people", "destination": "/index.html" },
    { "source": "/documents", "destination": "/index.html" },
    { "source": "/finance", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/capture", "destination": "/index.html" },
    { "source": "/help", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://rbtuoavhxyflxzdexhke.supabase.co; font-src 'self'; connect-src 'self' https://rbtuoavhxyflxzdexhke.supabase.co wss://rbtuoavhxyflxzdexhke.supabase.co; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=(self), payment=()" }
      ]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/release.txt",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
