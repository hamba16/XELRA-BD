# Private R2 state bucket, separate from app/backup storage. R2 encrypts at rest.
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY carry bucket-scoped R2 credentials.
bucket = "xelra-terraform-state"
key = "xelra/production.tfstate"
region = "auto"
endpoints = { s3 = "https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com" }
skip_credentials_validation = true
skip_metadata_api_check = true
skip_region_validation = true
skip_requesting_account_id = true
skip_s3_checksum = true
use_path_style = true
use_lockfile = true
